{
  "name": "thane",
  "version": "0.2.0",
  "description": "Lightweight compile-time optimized component framework",
  "author": "Tim Louw",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "components",
    "framework",
    "signals",
    "reactive",
    "compiler",
    "typescript",
    "frontend",
    "light-dom"
  ],
  "homepage": "https://github.com/timlouw/thane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timlouw/thane.git"
  },
  "bugs": {
    "url": "https://github.com/timlouw/thane/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "dist/runtime/index.js",
  "types": "dist/runtime/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/compiler",
    "dist/contracts",
    "dist/runtime",
    "dist/ts-plugin/index.cjs",
    "client.d.ts"
  ],
  "bin": {
    "thane": "./dist/compiler/cli/thane.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/internal.d.ts",
      "import": "./dist/runtime/internal.js",
      "default": "./dist/runtime/internal.js"
    },
    "./router": {
      "types": "./dist/runtime/router-exports.d.ts",
      "import": "./dist/runtime/router-exports.js",
      "default": "./dist/runtime/router-exports.js"
    },
    "./runtime/dom": {
      "types": "./dist/runtime/dom-prototype.d.ts",
      "import": "./dist/runtime/dom-prototype.js",
      "default": "./dist/runtime/dom-prototype.js"
    },
    "./ts-plugin": {
      "require": "./dist/ts-plugin/index.cjs",
      "default": "./dist/ts-plugin/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/build-ts-plugin.ts",
    "test": "bun test ./src",
    "e2e:test": "playwright test -c ./e2e/playwright.config.ts",
    "e2e:test:headed": "playwright test -c ./e2e/playwright.config.ts --headed --workers=1",
    "e2e:ui": "playwright test -c ./e2e/playwright.config.ts --ui --headed --workers=1",
    "e2e:ui:trace": "playwright test -c ./e2e/playwright.config.ts --ui --headed --trace on --workers=1",
    "format": "prettier --write \"**/*.{ts,json,html}\"",
    "format:check": "prettier --check \"**/*.{ts,json,html}\"",
    "types:apps": "bun scripts/apps.ts types",
    "test:apps": "bun scripts/apps.ts typecheck",
    "test:benchmark": "bun pm pack --filename example-apps/benchmark/thane.tgz && cd example-apps/benchmark && rm -rf bun.lock node_modules/thane && bun install && bun run build",
    "bench": "bun bench/run.ts",
    "bench:compare": "bun bench/compare.ts",
    "snapshot:output": "bun scripts/snapshot/output.ts",
    "snapshot:compare": "bun scripts/snapshot/compare.ts",
    "snapshot:statements": "bun scripts/snapshot/statements.ts",
    "size": "bun scripts/size-report.ts",
    "check:exports": "bun scripts/check-exports.ts",
    "verify": "bun run format:check && bun run build && bun run test:benchmark && bun run test:apps && bun run test && bun run e2e:test"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "prettier": "^3.9.6"
  }
}
